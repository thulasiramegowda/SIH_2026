<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="/css/style.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>

<div class="flex h-screen overflow-hidden bg-[#0a0e1a]">
    <!-- SIDEBAR -->
    <%- include('../partials/sidebar.ejs') %>

    <!-- MAIN CONTENT -->
    <div class="flex-1 flex flex-col overflow-hidden">
        <!-- HEADER -->
        <%- include('../partials/header.ejs') %>

        <!-- DASHBOARD -->
        <main class="flex-1 overflow-y-auto p-6">
            <h2 class="text-xl font-semibold text-white mb-1">Select an Area to Explore</h2>
            <p class="text-sm text-gray-400 mb-6">Choose from our test locations to view AI-powered analysis</p>

            <!-- Area Cards -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 mb-6">
                <% areas.forEach((area, index) => { %>
                    <a href="/area/<%= area.id %>" class="block">
                        <div class="relative p-4 rounded-xl transition-all duration-300 cursor-pointer <%= selected.id === area.id ? 'bg-cyan-500/5 border-cyan-500/40 shadow-[0_0_60px_rgba(0,200,255,0.08)]' : 'bg-white/5 border border-white/5 hover:border-cyan-500/20' %>">
                            <div class="absolute top-3 right-3 z-10">
                                <span class="text-[10px] px-2 py-0.5 rounded-full font-medium <%= area.type === 'known' ? 'bg-blue-500/10 text-blue-400 border border-blue-500/20' : 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20' %>">
                                    <%= area.typeLabel %>
                                </span>
                            </div>
                            <div class="flex items-start gap-3">
                                <div class="flex-1 min-w-0">
                                    <div class="flex items-center gap-2 mb-0.5">
                                        <span class="text-[10px] font-medium <%= area.type === 'known' ? 'text-blue-400' : 'text-emerald-400' %>">
                                            <%= area.type === 'known' ? 'TEST CASE 0' + (index + 1) : 'CANDIDATE 0' + (index + 1) %>
                                        </span>
                                    </div>
                                    <h3 class="text-sm font-semibold text-white truncate"><%= area.name %></h3>
                                    <p class="text-xs text-gray-400 mt-0.5"><%= area.state %></p>
                                </div>
                                <div class="w-12 h-12 rounded-lg overflow-hidden bg-gradient-to-br from-cyan-900/40 to-cyan-700/20 flex items-center justify-center border border-white/5 flex-shrink-0">
                                    <span class="text-[10px] text-gray-500">Sat</span>
                                </div>
                            </div>
                            <div class="flex items-center justify-between mt-3 pt-2 border-t border-white/5">
                                <div class="flex items-center gap-2">
                                    <span class="text-[10px] px-2 py-0.5 rounded-full border font-medium <%= area.priority === 'HIGH' ? 'border-emerald-500/30 text-emerald-400 bg-emerald-500/10' : 'border-yellow-500/30 text-yellow-400 bg-yellow-500/10' %>">
                                        ● <%= area.priority %>
                                    </span>
                                    <span class="text-[10px] text-gray-500">Score</span>
                                    <span class="text-xs font-bold text-cyan-400"><%= area.score %></span>
                                </div>
                                <svg class="w-4 h-4 transition-all duration-300 <%= selected.id === area.id ? 'text-cyan-400' : 'text-gray-600' %>" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                                </svg>
                            </div>
                        </div>
                    </a>
                <% }); %>
            </div>

            <!-- Map + Analysis -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 mb-6">
                <div class="lg:col-span-2 relative rounded-xl overflow-hidden bg-[#0f1a2e] border border-white/5" style="min-height: 400px;">
                    <div class="absolute inset-0 flex items-center justify-center">
                        <div class="text-center">
                            <div class="w-20 h-20 mx-auto mb-4 rounded-full border-2 border-cyan-500/30 flex items-center justify-center">
                                <div class="w-12 h-12 rounded-full border-2 border-cyan-500/20 flex items-center justify-center">
                                    <div class="w-6 h-6 rounded-full bg-cyan-500/10 border border-cyan-500/30"></div>
                                </div>
                            </div>
                            <p class="text-gray-500 text-sm">Satellite Map</p>
                            <p class="text-gray-600 text-xs mt-1">Mapbox Integration</p>
                        </div>
                    </div>
                    <div class="absolute top-4 left-4 bg-black/60 backdrop-blur-sm rounded-lg px-3 py-2 border border-white/10">
                        <div class="flex items-center gap-2">
                            <div class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-pulse"></div>
                            <span class="text-xs font-medium text-white truncate"><%= selected.name %></span>
                            <span class="text-[10px] text-gray-400">|</span>
                            <span class="text-[10px] text-gray-400 hidden sm:inline"><%= selected.state %></span>
                        </div>
                        <div class="text-[10px] text-gray-500 mt-0.5"><%= selected.coordinates %></div>
                    </div>
                    <div class="absolute bottom-4 left-1/2 -translate-x-1/2 bg-black/60 backdrop-blur-sm rounded-lg border border-white/10 p-1 flex gap-1">
                        <button class="px-2.5 py-1 rounded-md text-[10px] bg-cyan-500/20 text-cyan-400 border border-cyan-500/20">Satellite</button>
                        <button class="px-2.5 py-1 rounded-md text-[10px] text-gray-400 hover:text-white hover:bg-white/5">NDVI</button>
                        <button class="px-2.5 py-1 rounded-md text-[10px] text-gray-400 hover:text-white hover:bg-white/5">Terrain</button>
                        <button class="px-2.5 py-1 rounded-md text-[10px] text-gray-400 hover:text-white hover:bg-white/5">False Color</button>
                    </div>
                    <div class="absolute bottom-4 left-4 flex items-center gap-2 text-[10px] text-gray-500">
                        <div class="w-10 h-0.5 bg-gray-600"></div>
                        <span>5 km</span>
                    </div>
                </div>

                <!-- Analysis Panel -->
                <div class="space-y-4">
                    <div class="bg-white/5 rounded-xl border border-white/5 p-4">
                        <div class="flex items-center justify-between mb-3">
                            <h3 class="text-sm font-medium text-gray-300">AI Analysis Result</h3>
                            <span class="text-[10px] text-gray-500">Model: Remote Sensing + ML</span>
                        </div>
                        <div class="flex items-center gap-4">
                            <div class="relative w-16 h-16 flex-shrink-0">
                                <svg class="w-16 h-16 -rotate-90">
                                    <circle cx="32" cy="32" r="26" fill="none" stroke="rgba(255,255,255,0.05)" stroke-width="5" />
                                    <circle cx="32" cy="32" r="26" fill="none" stroke="#22d3ee" stroke-width="5" stroke-dasharray="<%= (selected.score / 100) * 163.36 %> 163.36" stroke-linecap="round" />
                                </svg>
                                <div class="absolute inset-0 flex items-center justify-center">
                                    <div class="text-center">
                                        <span class="text-base font-bold text-white"><%= selected.score %></span>
                                        <span class="text-[10px] text-gray-500">/100</span>
                                    </div>
                                </div>
                            </div>
                            <div class="min-w-0">
                                <div class="flex items-center gap-2 flex-wrap">
                                    <span class="text-sm font-semibold text-<%= selected.priorityColor %>-400"><%= selected.priority %> Priority</span>
                                    <span class="text-[10px] px-2 py-0.5 rounded-full border <%= selected.priority === 'HIGH' ? 'border-emerald-500/30 text-emerald-400 bg-emerald-500/10' : 'border-yellow-500/30 text-yellow-400 bg-yellow-500/10' %>"><%= selected.priority %></span>
                                </div>
                                <p class="text-[11px] text-gray-400 mt-1 leading-relaxed"><%= selected.description %></p>
                            </div>
                        </div>
                        <div class="mt-3 p-2.5 rounded-lg bg-cyan-500/5 border border-cyan-500/10">
                            <p class="text-[11px] text-cyan-400 font-medium">⚡ Potential zone identified for further exploration.</p>
                        </div>
                    </div>

                    <div class="p-3 rounded-xl border <%= selected.type === 'known' ? 'bg-blue-500/5 border-blue-500/20' : 'bg-emerald-500/5 border-emerald-500/20' %>">
                        <div class="flex items-start gap-2.5">
                            <div class="p-1 rounded-lg flex-shrink-0 <%= selected.type === 'known' ? 'bg-blue-500/10 text-blue-400' : 'bg-emerald-500/10 text-emerald-400' %>">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                </svg>
                            </div>
                            <div class="min-w-0">
                                <p class="text-xs font-medium text-gray-200"><%= selected.type === 'known' ? 'Validation (Independent Reference)' : 'AI-Identified Candidate' %></p>
                                <p class="text-[11px] text-gray-400 mt-0.5 leading-relaxed"><%= selected.validation %></p>
                                <% if (selected.type === 'known') { %>
                                    <p class="text-[10px] text-blue-400/60 mt-1 flex items-center gap-1">
                                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                        </svg>
                                        Geological reference data was NOT used during prediction
                                    </p>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Indicators -->
            <div class="mb-6">
                <h3 class="text-sm font-medium text-gray-300 mb-1">Satellite-Derived Indicators</h3>
                <p class="text-xs text-gray-500 mb-3">Key environmental and spectral parameters used by the model</p>
                <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-2.5">
                    <div class="p-3 rounded-lg bg-white/5 border border-white/5 hover:border-white/10 hover:bg-white/10 transition-all duration-300">
                        <div class="flex items-center gap-1.5">
                            <span class="text-[10px] text-gray-500 uppercase tracking-wider">NDVI</span>
                        </div>
                        <p class="text-base font-semibold text-white mt-1"><%= selected.ndvi %></p>
                        <p class="text-[10px] text-gray-500">Vegetation Index</p>
                    </div>
                    <div class="p-3 rounded-lg bg-white/5 border border-white/5 hover:border-white/10 hover:bg-white/10 transition-all duration-300">
                        <div class="flex items-center gap-1.5">
                            <span class="text-[10px] text-gray-500 uppercase tracking-wider">NDMI</span>
                        </div>
                        <p class="text-base font-semibold text-white mt-1"><%= selected.ndmi %></p>
                        <p class="text-[10px] text-gray-500">Moisture Index</p>
                    </div>
                    <div class="p-3 rounded-lg bg-white/5 border border-white/5 hover:border-white/10 hover:bg-white/10 transition-all duration-300">
                        <div class="flex items-center gap-1.5">
                            <span class="text-[10px] text-gray-500 uppercase tracking-wider">LST</span>
                        </div>
                        <p class="text-base font-semibold text-white mt-1"><%= selected.lst %>°C</p>
                        <p class="text-[10px] text-gray-500">Land Surface Temp</p>
                    </div>
                    <div class="p-3 rounded-lg bg-white/5 border border-white/5 hover:border-white/10 hover:bg-white/10 transition-all duration-300">
                        <div class="flex items-center gap-1.5">
                            <span class="text-[10px] text-gray-500 uppercase tracking-wider">Elevation</span>
                        </div>
                        <p class="text-base font-semibold text-white mt-1"><%= selected.elevation %>m</p>
                        <p class="text-[10px] text-gray-500">Terrain Elevation</p>
                    </div>
                    <div class="p-3 rounded-lg bg-white/5 border border-white/5 hover:border-white/10 hover:bg-white/10 transition-all duration-300">
                        <div class="flex items-center gap-1.5">
                            <span class="text-[10px] text-gray-500 uppercase tracking-wider">Similarity</span>
                        </div>
                        <p class="text-base font-semibold text-white mt-1"><%= selected.spectralSimilarity %>%</p>
                        <p class="text-[10px] text-gray-500">Spectral Similarity</p>
                    </div>
                    <div class="p-3 rounded-lg bg-white/5 border border-white/5 hover:border-white/10 hover:bg-white/10 transition-all duration-300">
                        <div class="flex items-center gap-1.5">
                            <span class="text-[10px] text-gray-500 uppercase tracking-wider">Rainfall</span>
                        </div>
                        <p class="text-base font-semibold text-white mt-1"><%= selected.rainfall %>mm</p>
                        <p class="text-[10px] text-gray-500">Annual Precipitation</p>
                    </div>
                </div>
            </div>

            <!-- Footer -->
            <div class="text-center">
                <p class="text-xs text-gray-600 italic">"Hidden resources. Visible opportunities."</p>
            </div>
        </main>
    </div>
</div>

</body>
</html>